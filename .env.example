OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=8787
DATABASE_URL=postgresql://localhost:5432/coffee_recommendation_app
# Hosted Postgres providers such as Railway can use DATABASE_URL directly.
# If your provider exposes individual PG* vars instead, the server also reads:
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=
# Optional for hosted Postgres if SSL is required: require, no-verify, or disable
# PGSSLMODE=require
JWT_SECRET=change-me-before-production
